{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh:plugin-discovery:v1",
  "title": "DSH plugin discovery metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "windowDays", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "windowDays": { "const": 7 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fullName", "categories", "starGrowth7d"],
        "properties": {
          "fullName": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ui", "agents", "developer-tools", "models", "data",
                "integrations", "media", "security", "observability", "other"
              ]
            }
          },
          "starGrowth7d": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
